# Shelterflex API — environment configuration
#
# Quick start: `cp .env.example .env` then `npm run dev`. The defaults below
# boot the API in development mode against a local Postgres and either a
# local Redis or REDIS_DISABLED=true — no external credentials needed.
#
# Convention used throughout this file:
#   [REQUIRED] — startup fails without a valid value; placeholders below are
#                 fake and MUST be replaced before running against real data.
#   [OPTIONAL] — has a working default; only change it if you need to.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# [OPTIONAL] HTTP port the API listens on.
PORT=4000

# [OPTIONAL] Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Rate limiting (public endpoints: /health, /soroban/config)
# ---------------------------------------------------------------------------
# [OPTIONAL]
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ---------------------------------------------------------------------------
# Redis (rate limiting, quotas, caching). Fails open: if Redis is unreachable,
# affected requests are still served (see src/utils/redis.ts).
# ---------------------------------------------------------------------------
# [OPTIONAL]
REDIS_URL=redis://localhost:6379
# Set to true to skip Redis entirely and use an in-memory mock.
# Intended for local development only — do not set in production.
REDIS_DISABLED=false

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# [REQUIRED] Postgres connection string. Format:
#   postgres://<user>:<password>@<host>:<port>/<database>
# The value below matches a local `postgres://app:app@localhost:5432/app`
# database — create it locally, or point this at your own instance.
DATABASE_URL=postgres://app:app@localhost:5432/app

# [REQUIRED] Symmetric key used to encrypt sensitive data at rest (custodial
# wallet secrets, PII, etc.) with AES-256-GCM. Must be at least 32 characters.
# The value below is a placeholder, not a usable secret — generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=replace-me-with-a-real-32-byte-secret

# [REQUIRED] HMAC secret used to sign and verify inbound webhook requests
# (see src/security/webhookVerifier.ts). Any non-empty string works locally;
# generate a real random secret for anything beyond local development, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_KEY=replace-me-with-a-generated-webhook-signing-key

# Inbound webhook anti-replay window. Providers must sign
# "<x-webhook-timestamp>.<raw request body>". Default: 300 seconds.
# [OPTIONAL]
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300

# ---------------------------------------------------------------------------
# Soroban / Stellar
# ---------------------------------------------------------------------------
# [OPTIONAL]
SOROBAN_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
SOROBAN_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# [OPTIONAL] Contract id for the deployed Shelterflex contract.
SOROBAN_CONTRACT_ID=

# [OPTIONAL] Soroban contract IDs (set after deploying contracts).
SOROBAN_USDC_TOKEN_ID=
SOROBAN_STAKING_POOL_ID=
SOROBAN_STAKING_REWARDS_ID=
SOROBAN_TIMELOCK_ID=
SOROBAN_INSPECTOR_BOND_ID=
SOROBAN_DEAL_ESCROW_ID=
SOROBAN_RENT_PAYMENTS_ID=
SOROBAN_REWARD_DISTRIBUTION_ID=
SOROBAN_WHISTLEBLOWER_VALIDATION_ID=
SOROBAN_TENANT_REPUTATION_ID=

# [OPTIONAL] Secret key used to sign Soroban transactions (e.g., your operator identity).
SOROBAN_ADMIN_SECRET=

# [OPTIONAL in development/test; REQUIRED otherwise] USDC token contract address.
# Must be a 56-character Stellar StrKey starting with "C" when set.
# Testnet example: USDC_TOKEN_ADDRESS=CAQGAQLQFJZ7PLOMCQN2I2NXHLQXF5DDD7T3IZQDTCZP3VYP7DVHLVSA
USDC_TOKEN_ADDRESS=

# ---------------------------------------------------------------------------
# Custodial wallet master keys (envelope encryption KEKs)
# ---------------------------------------------------------------------------
# [OPTIONAL in development/test; REQUIRED in production]
# Base64-encoded 32-byte AES-256 key for encrypting wallet secret keys.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# SECURITY: Never commit actual keys to git. Used for AES-256-GCM encryption at rest.
CUSTODIAL_WALLET_MASTER_KEY_V1=
CUSTODIAL_WALLET_MASTER_KEY_V2=
# [OPTIONAL] Active version for new wallets and rotation target (1 or 2).
CUSTODIAL_WALLET_MASTER_KEY_ACTIVE_VERSION=1

# [OPTIONAL] Custodial mode configuration.
CUSTODIAL_MODE_ENABLED=true
CUSTODIAL_SIGNING_PAUSED=false

# ---------------------------------------------------------------------------
# Indexer configuration
# ---------------------------------------------------------------------------
# [OPTIONAL]
INDEXER_POLL_MS=5000
INDEXER_START_LEDGER=

# ---------------------------------------------------------------------------
# NGN → USDC conversion (deposits / staking on-ramp)
# ---------------------------------------------------------------------------
# [OPTIONAL]
FX_RATE_NGN_PER_USDC=1600
# stub | http | fallback
CONVERSION_PROVIDER=stub
# [OPTIONAL, REQUIRED when CONVERSION_PROVIDER=http]
CONVERSION_RATE_URL=
CONVERSION_RATE_API_KEY=
CONVERSION_HTTP_TIMEOUT_MS=10000
CONVERSION_RATE_MIN=1
CONVERSION_RATE_MAX=50000

# ---------------------------------------------------------------------------
# Secret rotation
# ---------------------------------------------------------------------------
# Secrets are automatically hot-reloaded when environment variables change.
# Grace period allows old secrets to remain valid during rotation:
# default 5 minutes for most secrets, 15 minutes for encryption keys.
# Audit logs are written to ./logs/secret-rotation-audit.log
# [OPTIONAL]
AUDIT_LOG_DIR=./logs

# ---------------------------------------------------------------------------
# OTP delivery (Resend)
# ---------------------------------------------------------------------------
# [OPTIONAL] console | email
OTP_DELIVERY_PROVIDER=console
# [REQUIRED when OTP_DELIVERY_PROVIDER=email]
RESEND_API_KEY=
RESEND_FROM_EMAIL=otp@yourdomain.com

# ---------------------------------------------------------------------------
# Metrics & monitoring
# ---------------------------------------------------------------------------
# [OPTIONAL] Prometheus exporter port for metrics scraping.
PROMETHEUS_PORT=9464
METRICS_TOKEN=replace-with-secure-random-token

# [OPTIONAL] OpenTelemetry configuration.
OTEL_SERVICE_NAME=shelterflex-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SAMPLING_RATIO=1.0
# Custom headers for OTLP exporter (format: key=value,key2=value2)
OTEL_EXPORTER_OTLP_HEADERS=

# ---------------------------------------------------------------------------
# Object storage
# ---------------------------------------------------------------------------
# [OPTIONAL] Storage provider: local (filesystem, no credentials needed) or
# s3 (AWS S3 or MinIO, requires credentials below). `local` is the friendlier
# zero-config default for local development.
STORAGE_PROVIDER=local

# Local storage configuration (used when STORAGE_PROVIDER=local).
LOCAL_STORAGE_DIR=/tmp/shelterflex-dev

# S3 configuration (used when STORAGE_PROVIDER=s3) — uncomment and fill in
# to use AWS S3 or a MinIO instance instead of local disk.
# S3_BUCKET=tenant-documents
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=  # For MinIO: http://localhost:9000
# S3_FORCE_PATH_STYLE=true  # Set to true for MinIO

# ---------------------------------------------------------------------------
# E-Signature provider (lease agreements)
# ---------------------------------------------------------------------------
# [OPTIONAL] Provider to use for lease e-signatures.
#   stub    – in-memory provider, no external calls (default).
#   docuseal – real DocuSeal-backed provider (self-hosted or cloud).
ESIGN_PROVIDER=stub

# [REQUIRED when ESIGN_PROVIDER=docuseal] DocuSeal base URL.
# For self-hosted: http://localhost:3000
# For DocuSeal cloud: https://api.docuseal.com
DOCUSEAL_API_URL=http://localhost:3000

# [REQUIRED when ESIGN_PROVIDER=docuseal] DocuSeal API auth token.
# Generate in DocuSeal dashboard → Settings → API.
DOCUSEAL_API_KEY=

# [REQUIRED when ESIGN_PROVIDER=docuseal] Shared secret for verifying inbound
# webhook signatures (HMAC-SHA-256).  Set this in DocuSeal webhook settings
# and mirror the value here.  Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DOCUSEAL_WEBHOOK_SECRET=

# Feature flag — lease agreement generation + e-signature workflow.
# Set to true to enable the lease signing endpoints.
FEATURE_FLAG_LEASE_AGREEMENTS_ENABLED=false
